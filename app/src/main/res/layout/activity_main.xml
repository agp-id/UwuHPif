<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Spoof Bootloader -->
            <Switch
                android:id="@+id/switchBootloader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spoof Bootloader" />

            <!-- 2. Spoof PIF -->
            <Switch
                android:id="@+id/switchPIF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spoof PIF" />

            <!-- 3. Cek Update -->
            <TextView
                android:id="@+id/tvAutoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Auto update: ON" />

            <TextView
                android:id="@+id/tvLastUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last update: -" />

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check Update Online" />

            <!-- 4. Manual Mode (Import keybox/pif & Edit pif) -->
            <Switch
                android:id="@+id/switchManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Manual Mode" />

            <LinearLayout
                android:id="@+id/panelManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnPickKeybox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pick Custom Keybox" />

                <TextView
                    android:id="@+id/tvKeyboxLastApply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last apply: -" />

                <Button
                    android:id="@+id/btnPickPIF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pick Custom PIF" />

                <TextView
                    android:id="@+id/tvPifLastApply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last apply: -" />

                <!-- Textbox Background Sedikit Abu-Abu -->
                <EditText
                    android:id="@+id/etPifEditor"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="#1E1E1E"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:padding="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnApplyManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apply Manual PIF" />
            </LinearLayout>

            <!-- 5. GameProps -->
            <Switch
                android:id="@+id/switchGameProps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enable GameProps" />

            <LinearLayout
                android:id="@+id/panelGamePropsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Switch
                    android:id="@+id/switchAutoUpdateDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto Update Devices List" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnGameProps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Edit App Config" />

                    <Button
                        android:id="@+id/btnDevices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Devices" />

                    <Button
                        android:id="@+id/btnResetGameProps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reset" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6. Thermals -->
            <Switch
                android:id="@+id/switchThermals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enable Per-App Thermals" />

            <LinearLayout
                android:id="@+id/panelThermalsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnThermals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit Thermals" />

                <Button
                    android:id="@+id/btnResetThermals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reset" />
            </LinearLayout>

            <!-- Garis Putih Pemisah -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF" />

            <!-- == Log Header & Tombol Copy Kecil == -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="== Log =="
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyLog"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="4dp"
                    android:text="Copy"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Text Log Hijau Size Kecil & Background Sedikit Abu-Abu -->
            <EditText
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="#1E1E1E"
                android:gravity="top"
                android:padding="8dp"
                android:text="[Log ready]"
                android:textColor="#00FF00"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
