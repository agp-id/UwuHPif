<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIF Manager"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ==================== CONFIG TOGGLES ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Konfigurasi"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchBootloader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enable Bootloader Spoof"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switchPIF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enable PIF Spoof"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switchProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Force Custom Provider"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switchDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Debug Mode"
            android:textSize="14sp" />

        <!-- ==================== ADDITIONAL FILES ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Additional Files"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLoadGameProps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Load GameProps JSON" />

        <Button
            android:id="@+id/btnLoadThermals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Load Thermal JSON" />

        <!-- ==================== AUTO MODE ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mode Auto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Update Otomatis saat Boot"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLastUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Last update: -"
            android:textSize="12sp"
            android:textColor="#555555" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="UPDATE" />

        <!-- ==================== MANUAL MODE ==================== -->
        <LinearLayout
            android:id="@+id/panelManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mode Manual"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPickKeybox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pilih Keybox (.xml)" />

            <Button
                android:id="@+id/btnPickPIF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pilih PIF (.prop / .json)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Custom PIF Editor"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPifEditor"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="4dp"
                android:background="#F5F5F5"
                android:gravity="top|start"
                android:padding="8dp"
                android:textSize="12sp"
                android:typeface="monospace" />

            <Button
                android:id="@+id/btnApplyManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="APPLY" />

        </LinearLayout>

        <!-- ==================== RESET ==================== -->
        <Button
            android:id="@+id/btnResetPersist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reset Persist Properties" />

        <!-- ==================== STATUS ==================== -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ready"
            android:textSize="12sp"
            android:textColor="#555555" />

    </LinearLayout>
</ScrollView>
