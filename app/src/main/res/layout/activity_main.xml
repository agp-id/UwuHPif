<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Global Switches -->
            <Switch
                android:id="@+id/switchManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manual Mode" />

            <Switch
                android:id="@+id/switchBootloader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spoof Bootloader" />

            <Switch
                android:id="@+id/switchPIF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spoof PIF" />

            <!-- GameProps Section -->
            <Switch
                android:id="@+id/switchGameProps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable GameProps" />

            <LinearLayout
                android:id="@+id/panelGamePropsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Switch
                    android:id="@+id/switchAutoUpdateDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto Update Devices List" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnGameProps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Edit App Config" />

                    <Button
                        android:id="@+id/btnDevices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Devices" />

                    <Button
                        android:id="@+id/btnResetGameProps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reset" />
                </LinearLayout>
            </LinearLayout>

            <!-- Thermals Section -->
            <Switch
                android:id="@+id/switchThermals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Per-App Thermals" />

            <LinearLayout
                android:id="@+id/panelThermalsBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnThermals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit Thermals" />

                <Button
                    android:id="@+id/btnResetThermals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reset" />
            </LinearLayout>

            <!-- Status & Update Panel -->
            <TextView
                android:id="@+id/tvAutoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto update: ON" />

            <TextView
                android:id="@+id/tvLastUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last update: -" />

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check Update Online" />

            <!-- Manual Editor Panel -->
            <LinearLayout
                android:id="@+id/panelManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnPickKeybox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pick Custom Keybox" />

                <TextView
                    android:id="@+id/tvKeyboxLastApply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last apply: -" />

                <Button
                    android:id="@+id/btnPickPIF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pick Custom PIF" />

                <TextView
                    android:id="@+id/tvPifLastApply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last apply: -" />

                <EditText
                    android:id="@+id/etPifEditor"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="top"
                    android:inputType="textMultiLine" />

                <Button
                    android:id="@+id/btnApplyManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apply Manual PIF" />
            </LinearLayout>

            <Button
                android:id="@+id/btnResetPersist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset Persist Props" />

            <!-- Log Viewer -->
            <EditText
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top"
                android:text="[Log ready]" />

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Copy Log" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
