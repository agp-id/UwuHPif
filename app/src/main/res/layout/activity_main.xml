<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ==================== CONFIG TOGGLES ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfigurasi"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchBootloader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enable Bootloader Spoof"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switchPIF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enable PIF Spoof"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switchProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Force Custom Provider"
            android:textSize="14sp" />

        <!-- ==================== MODE ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mode"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manual Mode"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAutoStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Auto update: ON"
            android:textSize="12sp"
            android:textColor="#555555"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLastUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Last update: -"
            android:textSize="12sp"
            android:textColor="#555555" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="UPDATE" />

        <!-- ==================== MANUAL MODE ==================== -->
        <LinearLayout
            android:id="@+id/panelManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual Settings"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPickKeybox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pilih Keybox (.xml)" />

            <TextView
                android:id="@+id/tvKeyboxLastApply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last apply: -"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp" />

            <Button
                android:id="@+id/btnPickPIF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pilih PIF (.prop / .json)" />

            <TextView
                android:id="@+id/tvPifLastApply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last apply: -"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Custom PIF Editor"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPifEditor"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="4dp"
                android:background="#F5F5F5"
                android:gravity="top|start"
                android:padding="8dp"
                android:textSize="12sp"
                android:typeface="monospace"
                android:textColor="#000000" />

            <Button
                android:id="@+id/btnApplyManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="APPLY" />

        </LinearLayout>

        <!-- ==================== EDITOR: GAMEPROPS ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="GameProps Editor"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGameProps"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="4dp"
            android:background="#F5F5F5"
            android:gravity="top|start"
            android:padding="8dp"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textColor="#000000"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnGameProps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit GameProps" />

            <Button
                android:id="@+id/btnResetGameProps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Config"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <!-- ==================== EDITOR: THERMALS ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Thermals Editor"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etThermals"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="4dp"
            android:background="#F5F5F5"
            android:gravity="top|start"
            android:padding="8dp"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textColor="#000000"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnThermals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit Thermals" />

            <Button
                android:id="@+id/btnResetThermals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Config"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <!-- ==================== RESET ==================== -->
        <Button
            android:id="@+id/btnResetPersist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reset Configuration" />

        <!-- ==================== DIVIDER ==================== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#CCCCCC" />

        <!-- ==================== DEBUG TOGGLE ==================== -->
        <Switch
            android:id="@+id/switchDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Debug Mode"
            android:textSize="14sp" />

        <!-- ==================== LOG VIEWER ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvLogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="=== Debug Log ==="
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy"
                android:textSize="10sp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScrollView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="4dp"
            android:background="#1A1A1A"
            android:padding="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[Log ready]"
                android:textColor="#00FF00"
                android:textSize="10sp"
                android:typeface="monospace"
                android:textIsSelectable="true" />

        </ScrollView>

    </LinearLayout>
</ScrollView>
