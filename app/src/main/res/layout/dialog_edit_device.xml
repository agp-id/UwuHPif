<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDeviceDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Device Configuration"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Device Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Device Name:"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. ROG Phone 7"
        android:inputType="text"
        android:textSize="15sp" />

    <!-- Manufacturer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Manufacturer:"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etManufacturer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. Asus"
        android:inputType="text"
        android:textSize="15sp" />

    <!-- Brand -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Brand (Optional/auto matches Manufacturer):"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. Asus"
        android:inputType="text"
        android:textSize="15sp" />

    <!-- Model -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Model:"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. ASUS_AI2205"
        android:inputType="text"
        android:textSize="15sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDeleteDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSaveDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
